{
  "name": "coding-progress-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faculty coding progress tracking web application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "npm --prefix server run prisma:generate && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "vercel-build": "npm run build",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix server run test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "vite": "^5.2.11"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
